# ── LLM ─────────────────────────────────────────────────────────────────────
# 支持任何 OpenAI SDK 兼容服务，切换供应商只需改这三行
# 示例见 docs/configuration.md
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=                       # 留空使用 OpenAI 默认端点；其他服务填写对应端点

LLM_TIMEOUT_SECONDS=60
LLM_MAX_CONCURRENT=10

# ── 数据源 ────────────────────────────────────────────────────────────────────
DATASOURCE_TYPE=mock                # 当前支持 mock，可扩展 clickhouse / mysql 等

# ── 安全 ──────────────────────────────────────────────────────────────────────
# SQL 白名单表名，必须与 backend/config/semantic_model.yaml 中的物理表名一致
ALLOWED_TABLES=dw.fact_orders,dw.fact_refunds,dw.fact_user_daily,dw.dim_users,dw.fact_product_sales,dw.dim_products,dw.fact_page_views,dw.fact_channel_traffic

# 管理接口 Token，生产环境必须修改
ADMIN_TOKEN=change-me-in-production

# 允许跨域的前端来源（逗号分隔）
ALLOWED_ORIGINS=http://localhost:5173

# ── 限流 ──────────────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=20

# ── 会话 ──────────────────────────────────────────────────────────────────────
SESSION_TTL_SECONDS=1800            # 不活跃超时时间（秒）

# ── 复杂度 ────────────────────────────────────────────────────────────────────
COMPLEXITY_THRESHOLD=100000000      # 预估扫描行数上限（1 亿）

# ── 日志 ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                      # DEBUG / INFO / WARNING / ERROR

# ── 审计日志 ──────────────────────────────────────────────────────────────────
AUDIT_DB_PATH=data/audit.db         # SQLite 文件路径（相对于 backend 目录）
